; Engine configuration file for WILDMIGRATION.
; Headless rules engine — no visuals, no autoloads that touch rendering.

config_version=5

[application]

config/name="wildmigration"
config/description="WILDMIGRATION — TCG rules engine (Phase 2) + human-vs-AI client (Phase 3)."
config/features=PackedStringArray("4.5")
run/main_scene="res://client/main.tscn"
run/disable_stdout=false

[display]

; Design resolution; the canvas_items stretch + expand aspect makes both the 3D
; viewport and the anchored 2D UI fill the window at any size (no letterbox
; margins, no clipped menu). All UI is anchored, so expand is safe.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
